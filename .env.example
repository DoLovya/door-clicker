# ============================================================
# Door Clicker — Docker Compose 环境变量模板
# 使用方法：
#   cp .env.example .env
#   然后按需修改 .env 里的值
# 注意：.env 文件已被 .gitignore 忽略，不要提交到仓库
# ============================================================

# ---- 端口映射（避免和宿主机其他服务冲突时修改） ----
# Web UI / API / WebSocket
WEB_PORT=5000
# MQTT Broker
MQTT_PORT=1883

# ---- 运行模式 ----
# production   生产模式：gunicorn + eventlet worker + mem_limit
# development  开发模式：Flask dev server + 源码 bind mount（热重载）
ENV=production
FLASK_ENV=production

# ---- 调试（开发模式下使用） ----
# =1 时容器内用 debugpy 启动 app.py，监听 5678 端口供 IDE attach
# 注意：要 attach 成功需要在 docker-compose.yml 中解开 5678 端口映射的注释
DEBUGPY=0
